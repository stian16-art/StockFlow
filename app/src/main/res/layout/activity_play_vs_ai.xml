<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="#1A1A1A"
     android:orientation="vertical">

    <ScrollView
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:layout_weight="1">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="16dp"
             android:orientation="vertical">

            <FrameLayout
                 android:layout_height="28dp"
                 android:layout_width="match_parent"
                 android:layout_marginBottom="4dp">

                <View
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:background="#303030"
                     android:id="@+id/evalBarBlack" />

                <View
                     android:layout_height="match_parent"
                     android:layout_width="0dp"
                     android:background="#F0F0F0"
                     android:id="@+id/evalBarWhite"
                     android:layout_gravity="start" />

                <TextView
                     android:layout_height="match_parent"
                     android:layout_width="wrap_content"
                     android:paddingEnd="8dp"
                     android:gravity="center_vertical"
                     android:textSize="14sp"
                     android:textColor="#FFFFFF"
                     android:paddingStart="8dp"
                     android:id="@+id/evalBarText"
                     android:textStyle="bold"
                     android:text="+0.00" />

            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent">

                <FrameLayout
                     android:layout_height="0dp"
                     android:layout_width="0dp"
                     app:layout_constraintTop_toTopOf="parent"
                     app:layout_constraintDimensionRatio="1:1"
                     app:layout_constraintStart_toStartOf="parent"
                     app:layout_constraintEnd_toEndOf="parent"
                     android:id="@+id/boardContainer">

                    <ImageView
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:scaleType="fitXY"
                         android:src="@drawable/chess_board" />

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:id="@+id/highlightContainer">

                    </FrameLayout>

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:id="@+id/coordinateContainer">

                    </FrameLayout>

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:id="@+id/arrowContainer">

                    </FrameLayout>

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:id="@+id/piecesContainer">

                    </FrameLayout>

                    <FrameLayout
                         android:layout_height="match_parent"
                         android:layout_width="match_parent"
                         android:id="@+id/interactionContainer">

                    </FrameLayout>

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:textSize="16sp"
                 android:textColor="#FFFFFF"
                 android:layout_marginTop="12dp"
                 android:id="@+id/statusText"
                 android:textStyle="bold"
                 android:text="Your move" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="16dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="wrap_content"
                     android:layout_marginEnd="8dp"
                     android:textColor="#FFFFFF"
                     android:text="AI Level:"
                     android:layout_gravity="center_vertical" />

                <SeekBar
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:max="20"
                     android:progress="10"
                     android:layout_weight="1"
                     android:id="@+id/skillSeekBar" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="32dp"
                     android:gravity="center"
                     android:textColor="#FFFFFF"
                     android:id="@+id/skillLevelText"
                     android:text="10" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="#EDEDED"
         android:padding="8dp"
         android:orientation="horizontal">

        <Button
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:id="@+id/playWhiteButton"
             android:text="New Game (White)" />

        <Button
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:layout_weight="1"
             android:id="@+id/playBlackButton"
             android:text="New Game (Black)" />

    </LinearLayout>

</LinearLayout>